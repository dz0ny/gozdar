---
import "../index.css";
import { Font } from "astro:assets";
import Schema from "@/components/Schema.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import type { Thing, WithContext } from "schema-dts";
import { SITE_DESCRIPTION, SITE_NAME } from "@/lib/site";
import ogImage from "@/assets/feature-graphic.png";

interface Props {
	title?: string;
	description?: string;
	noindex?: boolean;
	socialImageUrl?: string;
	schema?: WithContext<Thing> | WithContext<Thing>[];
}

const { url, site } = Astro;
const {
	title: pageTitle,
	description = SITE_DESCRIPTION,
	noindex = false,
	socialImageUrl = new URL(ogImage.src, site ?? url).href,
	schema,
} = Astro.props;

const title = pageTitle ? `${pageTitle} | ${SITE_NAME}` : `${SITE_NAME} — terenska aplikacija za lastnike gozdov`;
const canonical = new URL(url.pathname, site ?? url).href;
---

<!doctype html>
<html lang="sl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0f160f" />
    <script is:inline>document.documentElement.classList.add("js");</script>
    <Font cssVariable="--font-fraunces" preload />
    <Font cssVariable="--font-instrument" preload />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sl_SI" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:alt" content="Gozdar — terenska aplikacija za delo v gozdu" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    {schema && (Array.isArray(schema)
      ? schema.map((s) => <Schema item={s} />)
      : <Schema item={schema} />
    )}
  </head>

  <body class="min-h-screen flex flex-col overflow-x-clip">
    <a
      href="#vsebina"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-primary-foreground"
    >Preskoči na vsebino</a>
    <Header />
    <main id="vsebina" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      const els = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) =>
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in");
                io.unobserve(e.target);
              }
            }),
          { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("in"));
      }
    </script>
  </body>
</html>
