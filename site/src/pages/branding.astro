---
// Living style guide (not linked from navigation, noindex).
import Layout from "@/layouts/Layout.astro";

const swatches = [
	{ name: "background", hex: "#0f160f", role: "60 % — stran", cls: "bg-background" },
	{ name: "card", hex: "#182118", role: "površina 1", cls: "bg-card" },
	{ name: "muted", hex: "#242f23", role: "površina 2", cls: "bg-muted" },
	{ name: "border", hex: "#354135", role: "črte", cls: "bg-border" },
	{ name: "brand", hex: "#2e7d32", role: "30 % — polnila, ne za mali tekst", cls: "bg-brand" },
	{ name: "brand-bright", hex: "#63bc65", role: "zelen tekst, ikone", cls: "bg-brand-bright" },
	{ name: "primary", hex: "#d6a776", role: "10 % — CTA, ključne številke", cls: "bg-primary" },
	{ name: "foreground", hex: "#f2f0e7", role: "tekst", cls: "bg-foreground" },
	{ name: "muted-foreground", hex: "#b0bbb0", role: "telo besedila", cls: "bg-muted-foreground" },
	{ name: "faint", hex: "#919c91", role: "meta tekst", cls: "bg-faint" },
];
---

<Layout title="Slog" noindex={true}>
  <div class="container-page py-section space-y-20">
    <section>
      <h1 class="font-display text-6xl font-semibold">Gozdna tla</h1>
      <p class="mt-3 max-w-xl text-muted-foreground">Slog spletne strani Gozdar. Temna gozdna zelena, en tan poudarek, Fraunces + Instrument Sans.</p>
    </section>

    <section>
      <h2 class="font-display text-3xl font-semibold">Barve</h2>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {swatches.map((s) => (
          <li class="rounded-lg border border-border bg-card p-3">
            <div class:list={["h-20 rounded-md border border-border", s.cls]}></div>
            <p class="mt-3 font-semibold">{s.name}</p>
            <p class="font-mono text-sm text-faint">{s.hex}</p>
            <p class="text-sm text-muted-foreground">{s.role}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="space-y-4">
      <h2 class="font-display text-3xl font-semibold">Tipografija</h2>
      <p class="font-display text-7xl font-semibold leading-none">Hlodi in sečnja</p>
      <p class="font-display text-5xl font-semibold">Naslov H2 — Čašo žganja, šef</p>
      <p class="font-display text-2xl font-semibold">Naslov H3 — Gozdni sestoji</p>
      <p class="max-w-2xl text-muted-foreground">Telo besedila (Instrument Sans 400, 17 px): Vpišete premer in dolžino, aplikacija izračuna prostornino. Šumniki: č š ž Č Š Ž.</p>
      <p class="font-semibold">Instrument Sans 600 — poudarek</p>
    </section>

    <section class="flex flex-wrap gap-4">
      <a href="#" class="inline-flex h-13 items-center rounded-full bg-primary px-7 font-semibold text-primary-foreground hover:bg-primary-hover">Primarni gumb</a>
      <a href="#" class="inline-flex h-13 items-center rounded-full border border-border px-6 font-medium hover:bg-card">Sekundarni gumb</a>
      <span class="inline-block self-center rounded-full bg-muted px-2.5 py-0.5 text-sm font-semibold">Kmalu</span>
    </section>
  </div>
</Layout>
