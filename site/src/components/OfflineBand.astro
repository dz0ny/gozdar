---
const steps = [
	{ n: "1", title: "Doma, na Wi-Fi", body: "Poiščite parcelo ali označite območje in karte se prenesejo na telefon. V nastavitvah naložite še kataster in bazo lastnikov." },
	{ n: "2", title: "V gozdu, brez signala", body: "Prenesene karte, meje parcel, iskanje lastnikov in kompas delujejo naprej. Hlode beležite kot vedno." },
	{ n: "3", title: "Ob sodelavcu", body: "Česar on nima, mu pošljete s telefona na telefon prek skupnega omrežja. Brez ponovnega prenosa s spleta." },
];
---

<section class="relative isolate overflow-hidden bg-brand/90 py-section" aria-labelledby="brez-signala">
  <div class="bg-contours pointer-events-none absolute inset-0 -z-10 opacity-60 mix-blend-soft-light" aria-hidden="true"></div>
  <div class="container-page">
    <div class="grid gap-6 lg:grid-cols-12" data-reveal>
      <h2 id="brez-signala" class="font-display text-4xl font-semibold leading-tight text-foreground sm:text-5xl lg:col-span-8">
        V gozdu ni signala. Gozdar to ve.
      </h2>
    </div>
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {steps.map(({ n, title, body }) => (
        <li class="rounded-lg bg-background/85 p-7 backdrop-blur-sm" data-reveal>
          <span class="font-display text-5xl font-semibold text-primary" aria-hidden="true">{n}</span>
          <h3 class="mt-3 text-xl font-semibold">{title}</h3>
          <p class="mt-2 text-[0.97rem] text-muted-foreground">{body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
