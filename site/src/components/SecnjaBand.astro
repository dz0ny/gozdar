---
import { Axe, Crosshair, Send, MapPinned, Link2 } from "lucide-react";

const steps = [
	{
		icon: Crosshair,
		title: "Označite drevesa",
		body: "Dolgo pritisnite karto → Dodaj → Sečnja. Namerite križec na drevo in tapnite Označi. Vrsto izberete enkrat, vsaka oznaka se poveže s parcelo.",
	},
	{
		icon: Send,
		title: "Deli sekaču",
		body: "V parceli tapnite Deli sekaču in pošljite povezavo po SMS, Viberju ali e-pošti. Ko označite nova drevesa, povezavo posodobite.",
	},
	{
		icon: MapPinned,
		title: "Sekač dobi parcelo",
		body: "Povezava se odpre v Gozdarju in doda parcelo z drevesi v Moj gozd. Do vsakega drevesa ga pripelje puščica, tudi brez signala.",
	},
];
---

<section id="secnja" class="relative isolate overflow-hidden py-section scroll-mt-16" aria-labelledby="secnja-naslov">
  <div class="bg-contours pointer-events-none absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
  <div class="container-page grid items-center gap-12 lg:grid-cols-12">
    <div class="lg:col-span-7" data-reveal>
      <p class="inline-flex items-center gap-2 rounded-full border border-primary/40 px-3 py-1 text-sm font-semibold text-primary">
        <Axe className="size-4" aria-hidden="true" />
        Novo: deli sečnjo
      </p>
      <h2 id="secnja-naslov" class="mt-5 font-display text-4xl font-semibold leading-tight sm:text-5xl">
        Drevesa označite sami. Sekač jih najde brez vas.
      </h2>
      <p class="mt-5 max-w-xl text-lg text-muted-foreground">
        Namesto opisovanja po telefonu ali skupnega obhoda sestoja pošljete eno kratko sporočilo s povezavo. Sekač vidi parcelo in vsako označeno drevo na svoji karti.
      </p>

      <ol class="mt-10 grid gap-6 sm:grid-cols-3">
        {steps.map(({ icon: Icon, title, body }, i) => (
          <li class="border-t border-border pt-4">
            <div class="flex items-center gap-2.5">
              <span class="font-display text-2xl font-semibold text-primary">{i + 1}</span>
              <Icon className="size-5 text-brand-bright" aria-hidden="true" />
            </div>
            <p class="mt-3 font-semibold">{title}</p>
            <p class="mt-1 text-[0.95rem] text-muted-foreground">{body}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="lg:col-span-5" data-reveal>
      <figure class="mx-auto max-w-sm rounded-2xl border border-border bg-card p-6 shadow-2xl shadow-black/40">
        <figcaption class="text-sm text-faint">Sporočilo, ki ga dobi sekač (primer)</figcaption>
        <div class="mt-4 rounded-2xl rounded-bl-sm bg-muted p-4">
          <p class="font-semibold text-foreground">🪓 Sečnja · parc. 512/3</p>
          <p class="mt-1 text-[0.95rem] text-muted-foreground">14 dreves za posek</p>
          <p class="mt-3 flex items-center gap-1.5 break-all text-[0.95rem] text-primary">
            <Link2 className="size-4 shrink-0" aria-hidden="true" />
            gozdar.dz0ny.dev/o/…
          </p>
        </div>
        <ul class="mt-6 grid gap-3 text-[0.95rem] text-muted-foreground">
          <li class="border-t border-border pt-3">Povezava velja 30 dni od zadnje posodobitve.</li>
          <li class="border-t border-border pt-3">Spremembe lastnika se sekaču prenesejo same.</li>
          <li class="border-t border-border pt-3">Povezavo lahko kadarkoli prekličete. Brez računov in prijave.</li>
        </ul>
      </figure>
    </div>
  </div>
</section>
