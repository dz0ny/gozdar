---
import { Smartphone, Apple, Monitor, Store, Download } from "lucide-react";
import { APP_STORE_URL, LATEST_RELEASE_URL, RELEASES_URL } from "@/lib/site";

// TODO(launch): set this once the Play listing is public. While null, the card
// shows "Kmalu" and links nowhere.
const PLAY_URL: string | null = null; // https://play.google.com/store/apps/details?id=dev.dz0ny.gozdar
---

<section id="prenos" class="py-section scroll-mt-16" aria-labelledby="prenos-naslov">
  <div class="container-page">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end" data-reveal>
      <h2 id="prenos-naslov" class="font-display text-4xl font-semibold leading-tight sm:text-5xl lg:col-span-7">
        Namestite Gozdar.
      </h2>
      <p class="text-lg text-muted-foreground lg:col-span-5">
        Za iPhone in iPad je v App Storu, za Android kot datoteka APK. Google Play pride kmalu.
      </p>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-12">
      <article class="flex flex-col justify-between rounded-xl border border-primary/40 bg-card p-8 lg:col-span-6 lg:row-span-2 lg:p-10" data-reveal>
        <div>
          <Smartphone className="size-8 text-primary" aria-hidden="true" />
          <h3 class="mt-5 text-3xl font-semibold">Android</h3>
          <p class="mt-3 max-w-md text-muted-foreground">
            Prenesite APK zadnje izdaje z GitHuba in ga odprite na telefonu. Ob prvi namestitvi Android vpraša, ali dovolite namestitev iz brskalnika.
            Ta različica vas sama obvesti, ko izide nova.
          </p>
        </div>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={LATEST_RELEASE_URL}
            class="inline-flex h-13 whitespace-nowrap items-center justify-center gap-2.5 rounded-full bg-primary px-7 font-semibold text-primary-foreground transition-[transform,background-color] hover:-translate-y-0.5 hover:bg-primary-hover active:scale-[0.98]"
          >
            <Download className="size-5" aria-hidden="true" />
            Prenesi APK
          </a>
          <a href={RELEASES_URL} class="inline-flex h-13 whitespace-nowrap items-center justify-center rounded-full px-5 text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">
            Vse izdaje
          </a>
        </div>
      </article>

      <article class="rounded-xl border border-border bg-card p-7 lg:col-span-3" data-reveal>
        <Store className="size-6 text-brand-bright" aria-hidden="true" />
        <h3 class="mt-4 text-xl font-semibold">Google Play</h3>
        {PLAY_URL ? (
          <a href={PLAY_URL} class="mt-2 inline-block text-primary underline underline-offset-4">Odpri v trgovini</a>
        ) : (
          <p class="mt-2 text-[0.97rem] text-muted-foreground"><span class="mr-2 inline-block rounded-full bg-muted px-2.5 py-0.5 text-sm font-semibold text-foreground">Kmalu</span>Samodejne posodobitve prek trgovine.</p>
        )}
      </article>

      <article class="rounded-xl border border-border bg-card p-7 lg:col-span-3" data-reveal>
        <Apple className="size-6 text-brand-bright" aria-hidden="true" />
        <h3 class="mt-4 text-xl font-semibold">iPhone in iPad</h3>
        <p class="mt-2 text-[0.97rem] text-muted-foreground">Samodejne posodobitve prek trgovine.</p>
        <a href={APP_STORE_URL} class="mt-2 inline-block text-primary underline underline-offset-4 hover:text-primary-hover">Odpri v App Storu</a>
      </article>

      <article class="rounded-xl border border-border bg-card p-7 lg:col-span-6" data-reveal>
        <Monitor className="size-6 text-brand-bright" aria-hidden="true" />
        <h3 class="mt-4 text-xl font-semibold">Računalnik: macOS, Windows, Linux</h3>
        <p class="mt-2 text-[0.97rem] text-muted-foreground">
          Za pregled parcel in pripravo izvozov na večjem zaslonu. Arhiv za svoj sistem najdete med datotekami vsake
          <a href={RELEASES_URL} class="text-primary underline underline-offset-4 hover:text-primary-hover">izdaje na GitHubu</a>.
        </p>
      </article>
    </div>
  </div>
</section>
