---
import { Picture } from "astro:assets";
import { Download, ArrowDown } from "lucide-react";
import mapShot from "@/assets/screens/03-map.webp";
import parcelShot from "@/assets/screens/04-parcel.webp";
import { LATEST_RELEASE_URL } from "@/lib/site";
---

<section class="relative isolate overflow-hidden">
  <div class="bg-contours pointer-events-none absolute inset-0 -z-10 opacity-90 [mask-image:linear-gradient(to_bottom,black_55%,transparent)]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-40 top-10 -z-10 size-[36rem] rounded-full bg-brand/25 blur-3xl" aria-hidden="true"></div>

  <div class="container-page grid items-center gap-12 pb-16 pt-12 md:pt-16 lg:min-h-[calc(100dvh-4rem)] lg:grid-cols-12 lg:gap-8 lg:py-16">
    <div class="lg:col-span-7">
      <h1 class="entrance entrance-1 font-display text-[2.75rem] font-semibold leading-[1.02] sm:text-6xl lg:text-[5.25rem]">
        Vaš gozd na&nbsp;eni karti. <span class="text-primary">Tudi brez signala.</span>
      </h1>
      <p class="entrance entrance-2 mt-6 max-w-xl text-lg text-muted-foreground sm:text-xl">
        Gozdar pokaže meje parcel iz katastra, vodi evidenco hlodovine in vas s kompasom pripelje do mejnika.
        Za lastnike gozdov, izvajalce del in gozdarje v Sloveniji.
      </p>
      <div class="entrance entrance-3 mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={LATEST_RELEASE_URL}
          class="inline-flex h-13 whitespace-nowrap items-center justify-center gap-2.5 rounded-full bg-primary px-7 text-base font-semibold text-primary-foreground shadow-[0_10px_30px_-10px] shadow-primary/50 transition-[transform,background-color] hover:-translate-y-0.5 hover:bg-primary-hover active:scale-[0.98]"
        >
          <Download className="size-5" aria-hidden="true" />
          Prenesi za Android
        </a>
        <a
          href="#prenos"
          class="inline-flex h-13 whitespace-nowrap items-center justify-center gap-2 rounded-full border border-border px-6 text-base font-medium text-foreground transition-colors hover:border-faint hover:bg-card"
        >
          Druge naprave
          <ArrowDown className="size-4" aria-hidden="true" />
        </a>
      </div>
      <p class="entrance entrance-4 mt-6 text-sm text-faint">Brez oglasov in brez registracije. Podatki ostanejo na vašem telefonu.</p>
    </div>

    <div class="relative mx-auto w-full max-w-[26rem] lg:col-span-5 lg:max-w-none">
      <div class="relative ml-auto w-[72%] sm:w-[68%]">
        <div class="entrance entrance-2 overflow-hidden rounded-[2.2rem] border-[6px] border-muted bg-muted shadow-2xl shadow-black/60">
          <Picture
            src={mapShot}
            formats={["webp"]}
            fallbackFormat="webp"
            width={320}
            widths={[260, 320, 640]}
            sizes="(min-width: 1024px) 320px, 68vw"
            alt="Karta v aplikaciji Gozdar: ortofoto z mejami parcel iz katastra, shranjena parcela in drevesa, označena za sečnjo"
            loading="eager"
            fetchpriority="high"
            class="block h-auto w-full"
          />
        </div>
      </div>
      <div class="entrance entrance-4 absolute -bottom-6 left-0 w-[52%] -rotate-[5deg] sm:w-[48%]">
        <div class="overflow-hidden rounded-[1.8rem] border-[5px] border-muted bg-muted shadow-2xl shadow-black/70">
          <Picture
            src={parcelShot}
            formats={["webp"]}
            fallbackFormat="webp"
            width={230}
            widths={[200, 230, 460]}
            sizes="(min-width: 1024px) 230px, 48vw"
            alt="Podrobnosti parcele Borovec 1132/1: oblika na ortofotu, 68,90 ha mešanega gozda, k.o. in številka parcele"
            loading="eager"
            class="block h-auto w-full"
          />
        </div>
      </div>
    </div>
  </div>
</section>
