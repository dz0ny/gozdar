---
import icon from "@/assets/icon.png";
import { Picture } from "astro:assets";

const path = Astro.url.pathname;
const onHome = path === "/";
const links = [
	{ href: onHome ? "#funkcije" : "/#funkcije", label: "Funkcije" },
	{ href: onHome ? "#secnja" : "/#secnja", label: "Deli sečnjo" },
	{ href: onHome ? "#zasloni" : "/#zasloni", label: "Zasloni" },
	{ href: "/blog/", label: "Blog" },
	{ href: "/podpora/", label: "Podpora" },
];
// A page link is active on itself and on everything below it (/blog/ on every post).
const isActive = (href: string) => href.startsWith("/") && !href.startsWith("/#") && path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-border/70 bg-background/85 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 font-display text-xl font-semibold tracking-tight" aria-label="Gozdar, domov">
      <Picture
        src={icon}
        formats={["webp"]}
        fallbackFormat="webp"
        width={32}
        widths={[32, 64]}
        sizes="32px"
        alt=""
        class="size-8 rounded-[0.6rem]"
        loading="eager"
      />
      Gozdar
    </a>
    <nav aria-label="Glavna navigacija" class="flex items-center gap-1 sm:gap-2">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            "hidden rounded-md px-3 py-2 text-[0.95rem] text-muted-foreground transition-colors hover:text-foreground sm:inline-block",
            isActive(href) && "text-foreground",
          ]}
        >{label}</a>
      ))}
      <a
        href={onHome ? "#prenos" : "/#prenos"}
        class="ml-1 inline-flex h-10 whitespace-nowrap items-center rounded-full bg-primary px-5 text-[0.95rem] font-semibold text-primary-foreground transition-[transform,background-color] hover:-translate-y-0.5 hover:bg-primary-hover active:scale-[0.98]"
      >Prenesi</a>
    </nav>
  </div>
</header>
