# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

require "shellwords"
require "tmpdir"

require "deliver/languages"
require "fastlane_core/languages"

Deliver::Languages::ALL_LANGUAGES << "sl-SI" unless Deliver::Languages::ALL_LANGUAGES.include?("sl-SI")
FastlaneCore::Languages::ALL_LANGUAGES << "sl-SI" unless FastlaneCore::Languages::ALL_LANGUAGES.include?("sl-SI")

default_platform(:ios)

platform :ios do
  def project_root
    File.expand_path("../..", __dir__)
  end

  # tool/release.sh exports an App Store Connect key; with it these lanes run
  # with nobody at the keyboard, and without it they fall back to the
  # interactive Apple ID login they have always used.
  def asc_key
    return nil unless ENV["ASC_KEY_ID"] && ENV["ASC_KEY_P8"]

    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8"),
      is_key_content_base64: true,
      in_house: false,
    )
  end

  # pubspec's +build is a floor, not the last word: TestFlight knows what it
  # has already accepted, and a duplicate number is refused outright. So a
  # release no longer depends on remembering `make bump` first — bump when the
  # version should change, and the build number takes care of itself.
  def next_build_number(key)
    return ENV.fetch("RELEASE_BUILD", "1").to_i if key.nil?

    latest = latest_testflight_build_number(
      api_key: key,
      app_identifier: "dev.dz0ny.gozdar",
      version: ENV["RELEASE_VERSION"],
      initial_build_number: 0,
    )
    [ENV.fetch("RELEASE_BUILD", "0").to_i, latest + 1].max
  end

  # gym has no api_key option — it shells out to xcodebuild, so the key goes in
  # as authentication flags pointing at a file. Only the archive needs them:
  # gym adds the same flags to the export itself, and xcodebuild rejects a
  # repeated -authenticationKeyPath.
  def with_archive_args(build_number = nil, provisioning = true)
    return yield(nil) unless ENV["ASC_KEY_ID"] && ENV["ASC_KEY_P8"]

    path = File.join(Dir.tmpdir, "AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8")
    File.binwrite(path, ENV.fetch("ASC_KEY_P8").unpack1("m"))
    File.chmod(0o600, path)
    args = []
    if provisioning
      args += [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath", Shellwords.escape(path),
        "-authenticationKeyID", Shellwords.escape(ENV.fetch("ASC_KEY_ID")),
        "-authenticationKeyIssuerID", Shellwords.escape(ENV.fetch("ASC_ISSUER_ID")),
      ]
    end
    # A build setting on the command line outranks any xcconfig, so the number
    # the caller decided survives the archive regenerating Generated.xcconfig.
    if ENV["RELEASE_VERSION"]
      args << "FLUTTER_BUILD_NAME=#{ENV.fetch('RELEASE_VERSION')}"
      args << "FLUTTER_BUILD_NUMBER=#{build_number}" if build_number
    end
    begin
      yield(args.join(" "))
    ensure
      File.delete(path) if File.exist?(path)
    end
  end

  # Automatic signing makes xcodebuild want an iOS *Development* certificate,
  # and a CI runner has none, so every run asked Apple for a new one until the
  # account hit its certificate cap. The release is signed with the one Apple
  # Distribution certificate release.sh imports instead: fetch (or create) the
  # App Store profile for it, and point the Runner target at both. Nothing
  # here creates a certificate. The edit is to the checkout's project file
  # only, put back afterwards so a laptop release leaves the tree clean.
  def with_distribution_signing(key)
    return yield(nil) if key.nil? || ENV["IOS_AUTOMATIC_SIGNING"]

    bundle_id = "dev.dz0ny.gozdar"
    team = ENV.fetch("APPLE_TEAM_ID", "JND55328G8")
    pbxproj = File.join(project_root, "ios", "Runner.xcodeproj", "project.pbxproj")
    original = File.binread(pbxproj)

    get_provisioning_profile(
      api_key: key,
      app_identifier: bundle_id,
      team_id: team,
      provisioning_name: "Gozdar App Store",
    )
    profile = lane_context[SharedValues::SIGH_NAME]

    begin
      update_code_signing_settings(
        use_automatic_signing: false,
        path: File.join(project_root, "ios", "Runner.xcodeproj"),
        team_id: team,
        targets: ["Runner"],
        build_configurations: ["Release"],
        code_sign_identity: "Apple Distribution",
        profile_name: profile,
      )
      yield({
        export_method: "app-store",
        export_options: {
          signingStyle: "manual",
          provisioningProfiles: { bundle_id => profile },
        },
      })
    ensure
      File.binwrite(pbxproj, original)
    end
  end

  def build_signed(key, build)
    with_distribution_signing(key) do |signing|
      # With a fixed identity the archive must not ask Apple for anything, so
      # only the version flags are kept; the auth flags stay for the
      # interactive/automatic fallback.
      with_archive_args(build, signing.nil?) do |args|
        opts = { workspace: "Runner.xcworkspace", scheme: "Runner", xcargs: args }
        opts.merge!(signing) if signing
        build_app(opts)
      end
    end
  end

  def beta_app_info
    {
      "en-US" => {
        description: "Forestry field management for Slovenian forest parcels, timber logs, cadastral maps, and GPS navigation.",
        feedback_email: "hey@dz0ny.dev",
        marketing_url: "https://github.com/dz0ny/gozdar",
        privacy_policy_url: "https://github.com/dz0ny/gozdar"
      },
      "sl-SI" => {
        description: "Terensko upravljanje gozdnih parcel, hlodovine, katastrskih kart in GPS navigacije.",
        feedback_email: "hey@dz0ny.dev",
        marketing_url: "https://github.com/dz0ny/gozdar",
        privacy_policy_url: "https://github.com/dz0ny/gozdar"
      }
    }
  end

  def beta_build_info
    {
      "en-US" => {
        whats_new: "Test Gozdar forestry workflows: forest parcels, timber log volume tracking, offline maps, and GPS navigation."
      },
      "sl-SI" => {
        whats_new: "Preizkusite Gozdar za gozdne parcele, izmero hlodovine, zemljevide brez povezave in GPS navigacijo."
      }
    }
  end

  desc "Push a new beta build to TestFlight"
  lane :beta do
    key = asc_key
    build = next_build_number(key)
    UI.message("building #{ENV['RELEASE_VERSION'] || 'pubspec version'} (#{build})")
    build_signed(key, build)
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      localized_app_info: beta_app_info,
      localized_build_info: beta_build_info,
      changelog: "Test Gozdar forestry workflows: forest parcels, timber log volume tracking, offline maps, and GPS navigation."
    )
  end

  desc "Push a new release build to the App Store"
  # Build number / version come from pubspec.yaml via Flutter's
  # FLUTTER_BUILD_NUMBER / FLUTTER_BUILD_NAME (Generated.xcconfig).
  # Run `make bump` (or `flutter pub get`) before this lane to refresh them.
  lane :release do
    key = asc_key
    build = next_build_number(key)
    UI.message("building #{ENV['RELEASE_VERSION'] || 'pubspec version'} (#{build})")
    build_signed(key, build)
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      localized_app_info: beta_app_info,
      localized_build_info: beta_build_info,
      changelog: "Test Gozdar forestry workflows: forest parcels, timber log volume tracking, offline maps, and GPS navigation."
    )
  end

  desc "Capture iOS screenshots for App Store Connect"
  lane :screenshots do
    sh("cd #{project_root} && scripts/take_ios_screenshots.sh")
  end

  desc "Upload App Store screenshots"
  lane :store_assets do
    upload_to_app_store(
      api_key: asc_key,
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      submit_for_review: false,
      force: true
    )
  end
end
